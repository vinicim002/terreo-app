# Exemplo de variáveis de ambiente para DESENVOLVIMENTO LOCAL.
# Copie para .env (que não vai para o git) e ajuste se precisar.
# Nunca coloque aqui senhas ou chaves reais.

APP_ENV=development
APP_VERSION=0.1.0

# Banco e Redis do docker-compose (nomes de serviço da rede interna).
POSTGRES_USER=terreo
POSTGRES_PASSWORD=terreo-dev
POSTGRES_DB=terreo
DATABASE_URL=postgresql+asyncpg://terreo:terreo-dev@db:5432/terreo
REDIS_URL=redis://redis:6379/0

# Interface: dev | demo | real (research R6).
NEXT_PUBLIC_APP_MODE=dev
# Para onde o next dev repassa /api (research R9).
API_INTERNAL_URL=http://api:8100
