// Cloudflare Workers (com arquivos estáticos) — demonstração do Térreo em terreo.v2n.tech.
// No painel: diretório raiz `web`, build `npm run build:demo`, deploy `npx wrangler deploy`.
// Roteiro: docs/documentacao/05-publicacao.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terreo",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // O Worker só roda antes dos arquivos no /api; o resto é servido direto (rápido e sem custo de execução).
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "API_ORIGIN": "https://terreo-api.v2n.tech",
  },
  "observability": { "enabled": true },
}
