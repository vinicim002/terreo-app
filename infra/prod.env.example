# Modelo do infra/.env da VPS (produção do Térreo). Copie para infra/.env, `chmod 600` e preencha NO SERVIDOR.
# Nunca versione o .env nem cole os valores em chat, issue ou commit.

# Versão mostrada em /api/health.
APP_VERSION=0.1.0

# Senha do PostgreSQL: gerada no próprio servidor (veja docs/documentacao/05-publicacao.md).
DB_PASSWORD=

# Token do Cloudflare Tunnel "terreo-prod" (Zero Trust → Networks → Tunnels), da conta Cloudflare da V2N.
TUNNEL_TOKEN=

# Versão fixa do cloudflared.
CLOUDFLARED_TAG=2026.11.0
